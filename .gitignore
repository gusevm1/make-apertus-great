# Secrets and local config
.env
.env.*
!.env.example

# Model weights and checkpoints — do not commit these
*.bin
*.safetensors
*.gguf
*.ckpt
*.pt

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/
dist/
build/

# OS and editor
.DS_Store
.idea/
.vscode/

# Widget benchmark output, regenerated by every run
src/backend/evals/widgets/results/

# Eval report, regenerated by every run of python -m evals.report
src/backend/evals/report/index.html

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# OpenRouter replies cached by the board evals, so reruns cost nothing
src/backend/evals/cache/
