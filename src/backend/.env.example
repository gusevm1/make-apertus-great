# LLM_NAME, LLM_BASE_URL and LLM_API_KEY come from the .env in the repo root.
# Everything below has a working default for local development (see app/core/config.py).

# DATABASE_URL=postgresql+asyncpg://trustroom:trustroom@localhost:5433/trustroom
# TEST_DATABASE_URL=postgresql+asyncpg://trustroom:trustroom@localhost:5433/trustroom_test
# LLM_NAME_FAST=apertus-v1-5-8b
# The -thinking model that plans each turn's tool calls; unset, the decision plans alone.
# LLM_NAME_THINKING=apertus-v1-5-70b-thinking
# BANKING_API_URL=http://localhost:8000/api
# OCR_URL=http://localhost:8002
# APP_ORIGIN=http://localhost:3000
# LOG_LLM_CONTENT=true

# Web search, through our own SearXNG (from `src/`: `docker compose up -d searxng`). It sends the
# search query to search engines outside the bank, after the customer allowed it; empty means off.
# SEARXNG_URL=http://localhost:8089
