{#- A figure's change (a figure DATA holds, coloured by whether it goes the good way) and trend. #}
{% macro trend_and_change(n) -%}
{%- if n.change is not none %}
  <span class="change {{ n.change.tone }}" data-component="change" data-path="{{ n.change.path }}" data-value="{{ n.change.raw }}" data-booking-ids="{{ n.change.booking_ids }}"><span class="arrow" aria-hidden="true">{% if n.change.direction == "up" %}▲{% elif n.change.direction == "down" %}▼{% else %}–{% endif %}</span> {{ n.change.text }} {{ n.change.word }}{% if n.change.verdict is not none %} <span class="verdict">{{ n.change.verdict }}</span>{% endif %}</span>
{%- endif %}
{%- if n.trend is not none %}
  <div class="trend" data-component="trend" data-path="{{ n.trend.path }}" data-rows="{{ n.trend.rows }}"><div class="chart-area trend-area" id="{{ n.trend.id }}">{% if n.trend.svg is not none %}{{ n.trend.svg | safe }}{% endif %}</div></div>
{%- endif %}
{%- endmacro %}
{% macro node(n) -%}
{%- if n.type == "kpi" -%}
<section class="kpi" data-component="kpi" data-path="{{ n.path }}" data-value="{{ n.raw }}" data-booking-ids="{{ n.booking_ids }}">
  <span class="kpi-label">{{ n.label }}</span>
  <span class="kpi-value">{{ n.text }}</span>
  {%- if n.compare_text is not none %}
  <span class="kpi-compare" data-component="kpi-compare" data-path="{{ n.compare_path }}" data-value="{{ n.compare_raw }}" data-booking-ids="{{ n.compare_booking_ids }}">{{ n.compare_label }} {{ n.compare_text }}</span>
  {%- endif %}
  {{- trend_and_change(n) }}
</section>
{%- elif n.type == "stat_row" -%}
<section class="stats" data-component="stat_row">
  {%- for s in n.stats %}
  <div class="stat" data-component="stat" data-path="{{ s.path }}" data-value="{{ s.raw }}" data-booking-ids="{{ s.booking_ids }}">
    <span class="stat-label">{{ s.label }}</span>
    <span class="stat-value">{{ s.text }}</span>
    {{- trend_and_change(s) }}
  </div>
  {%- endfor %}
</section>
{%- elif n.type == "table" -%}
<section class="table-wrap" data-component="table" data-path="{{ n.path }}">
  {%- if n.title is not none %}<h2>{{ n.title }}</h2>{% endif %}
  <div class="table-scroll">
  {#- Explicit roles: below 560 px the table is laid out as cards, which drops the semantics in WebKit. #}
  <table role="table">
    <thead role="rowgroup"><tr role="row">{% for c in n.columns %}<th role="columnheader"{% if c.numeric %} class="num"{% endif %}>{{ c.title }}</th>{% endfor %}</tr></thead>
    <tbody role="rowgroup">
    {%- for r in n.rows %}
      <tr role="row" data-component="table-row" data-path="{{ r.path }}" data-values="{{ r.row_values }}" data-booking-ids="{{ r.booking_ids }}">
        {%- for cell in r.cells %}<td role="cell" data-label="{{ n.columns[loop.index0].title }}"{% if n.columns[loop.index0].numeric %} class="num"{% elif n.columns[loop.index0].date %} class="date"{% endif %}>{{ cell }}</td>{% endfor %}
      </tr>
    {%- endfor %}
    </tbody>
    {%- if n.total is not none %}
    <tfoot role="rowgroup"><tr role="row" data-component="table-total" data-path="{{ n.total.path }}" data-value="{{ n.total.raw }}" data-booking-ids="{{ n.total.booking_ids }}">
      {%- for cell in n.total.cells %}<td role="cell" data-label="{{ n.columns[loop.index0].title }}"{% if cell.numeric %} class="num"{% endif %}>{{ cell.text }}</td>{% endfor %}
    </tr></tfoot>
    {%- endif %}
  </table>
  </div>
  {%- if n.cut_note is not none %}<p class="cut-note">{{ n.cut_note }}</p>{% endif %}
</section>
{%- elif n.type == "list" -%}
<section class="list" data-component="list" data-path="{{ n.path }}">
  {%- if n.title is not none %}<h2>{{ n.title }}</h2>{% endif %}
  <ul>
  {%- for i in n.entries %}
    <li data-component="list-item" data-path="{{ i.path }}" data-values="{{ i.row_values }}" data-booking-ids="{{ i.booking_ids }}">
      <span class="item-main"><span class="item-label">{{ i.label }}</span>{% if i.detail is not none %}<span class="item-detail">{{ i.detail }}</span>{% endif %}</span>
      <span class="item-value">{{ i.value }}</span>
    </li>
  {%- endfor %}
  </ul>
  {%- if n.cut_note is not none %}<p class="cut-note">{{ n.cut_note }}</p>{% endif %}
</section>
{%- elif n.type == "timeline" -%}
<section class="timeline" data-component="timeline" data-path="{{ n.path }}">
  {%- if n.title is not none %}<h2>{{ n.title }}</h2>{% endif %}
  <ol>
  {%- for i in n.entries %}
    <li data-component="timeline-item" data-path="{{ i.path }}" data-values="{{ i.row_values }}" data-booking-ids="{{ i.booking_ids }}">
      <span class="tl-date">{{ i.date }}</span>
      <span class="tl-dot" aria-hidden="true"></span>
      <span class="item-main"><span class="item-label">{{ i.label }}</span>{% if i.detail is not none %}<span class="item-detail">{{ i.detail }}</span>{% endif %}</span>
      <span class="item-value">{{ i.value }}</span>
    </li>
  {%- endfor %}
  </ol>
  {%- if n.cut_note is not none %}<p class="cut-note">{{ n.cut_note }}</p>{% endif %}
</section>
{%- elif n.type == "progress" -%}
<section class="progress" data-component="progress" data-path="{{ n.value.path }}" data-value="{{ n.value.raw }}" data-booking-ids="{{ n.value.booking_ids }}">
  <span class="kpi-label">{{ n.label }}</span>
  <span class="progress-figures"><span class="progress-value">{{ n.value.text }}</span>
  <span class="progress-goal" data-component="progress-goal" data-path="{{ n.goal.path }}" data-value="{{ n.goal.raw }}" data-booking-ids="{{ n.goal.booking_ids }}">{{ n.goal_label }} {{ n.goal.text }}</span></span>
  <span class="progress-track" role="img" aria-label="{{ n.label }}: {{ n.value.text }}, {{ n.goal_label }} {{ n.goal.text }}"><span class="progress-fill" style="width: {{ n.fill }}%"></span></span>
</section>
{%- elif n.type == "budget_bars" -%}
<section class="budgets" data-component="budget_bars" data-path="{{ n.path }}">
  {%- if n.title is not none %}<h2>{{ n.title }}</h2>{% endif %}
  <ul>
  {%- for r in n.rows %}
    <li class="budget{% if r.over %} over{% endif %}" data-component="budget-row" data-path="{{ r.path }}" data-values="{{ r.row_values }}" data-booking-ids="{{ r.booking_ids }}">
      <span class="budget-head"><span class="item-label">{{ r.name }}</span><span class="budget-status">{{ r.status }}</span></span>
      <span class="budget-spent">{{ r.spent }}</span>
      <span class="budget-track" role="img" aria-label="{{ r.name }}: {{ r.spent }}, {{ r.status }}{% if n.today is not none %}, {{ n.today.label }}{% endif %}"><span class="budget-fill" style="width: {{ r.fill }}%"></span>{% if n.today is not none %}<span class="budget-today" style="left: {{ n.today.at }}%"></span>{% endif %}</span>
    </li>
  {%- endfor %}
  </ul>
  {%- if n.today is not none %}<p class="cut-note"><i class="key today" aria-hidden="true"></i> {{ n.today.label }}</p>{% endif %}
</section>
{%- elif n.type == "callout" -%}
<aside class="callout tone-{{ n.tone }}" data-component="callout">
  {%- if n.title is not none %}<strong>{{ n.title }}</strong>{% endif %}
  <p>{{ n.text }}</p>
</aside>
{%- elif n.type == "scenarios" -%}
<section class="scenarios" data-component="scenarios" data-path="{{ n.path }}">
  {%- if n.title is not none %}<h2>{{ n.title }}</h2>{% endif %}
  {%- if n.form == "live" %}
  <fieldset class="cases"><legend class="sr-only">{% if n.title is not none %}{{ n.title }}{% else %}Choose a case{% endif %}</legend>
    {%- for c in n.cases %}<label class="case-option"><input type="radio" name="{{ n.group }}" value="{{ c.index }}"{% if loop.first %} checked{% endif %}><span>{{ c.label }}</span></label>{% endfor %}
  </fieldset>
  {#- One live region that stays on the page, so a switch is announced. #}
  <div class="case-panels" aria-live="polite">
  {%- for c in n.cases %}
  <div class="stats case" data-case="{{ c.index }}" data-path="{{ c.path }}"{% if not loop.first %} hidden{% endif %}>
    {%- for f in c.figures %}
    <div class="stat" data-component="scenario-figure" data-path="{{ f.path }}" data-value="{{ f.raw }}" data-booking-ids="{{ f.booking_ids }}"><span class="stat-label">{{ f.label }}</span><span class="stat-value">{{ f.text }}</span></div>
    {%- endfor %}
  </div>
  {%- endfor %}
  </div>
  {%- else %}
  {%- set first = n.cases[0] %}
  <p class="case-shown">{{ first.label }}</p>
  <div class="stats case" data-case="0" data-path="{{ first.path }}">
    {%- for f in first.figures %}
    <div class="stat" data-component="scenario-figure" data-path="{{ f.path }}" data-value="{{ f.raw }}" data-booking-ids="{{ f.booking_ids }}"><span class="stat-label">{{ f.label }}</span><span class="stat-value">{{ f.text }}</span></div>
    {%- endfor %}
  </div>
  <div class="table-wrap"><div class="table-scroll">
  <table role="table">
    <thead role="rowgroup"><tr role="row"><th role="columnheader">Case</th>{% for label in n.labels %}<th role="columnheader" class="num">{{ label }}</th>{% endfor %}</tr></thead>
    <tbody role="rowgroup">
    {%- for c in n.cases %}
      <tr role="row" data-component="scenario-case" data-path="{{ c.path }}"><td role="cell" data-label="Case">{{ c.label }}</td>{% for f in c.figures %}<td role="cell" class="num" data-label="{{ f.label }}">{{ f.text }}</td>{% endfor %}</tr>
    {%- endfor %}
    </tbody>
  </table>
  </div></div>
  {%- endif %}
</section>
{%- elif n.type in ("bar_chart", "line_chart", "area_chart", "comparison", "donut", "forecast_chart", "waterfall", "calendar") -%}
<section class="chart" data-component="{{ n.type }}" data-path="{{ n.path }}" data-rows="{{ n.rows }}">
  {%- if n.title is not none %}<h2>{{ n.title }}</h2>{% endif %}
  {%- if n.legend is not none %}
  <div class="donut">
    <div class="chart-area donut-area" id="{{ n.id }}">{% if n.svg is not none %}{{ n.svg | safe }}{% endif %}</div>
    <div class="donut-side">
      {%- if n.total is not none %}
      <p class="donut-total" data-component="donut-total" data-path="{{ n.total.path }}" data-value="{{ n.total.raw }}" data-booking-ids="{{ n.total.booking_ids }}"><span class="kpi-label">Total</span> <span class="stat-value">{{ n.total.text }}</span></p>
      {%- endif %}
      <ul class="legend">
      {%- for e in n.legend %}
        <li data-component="donut-slice" data-path="{{ e.path }}" data-value="{{ e.raw }}" data-booking-ids="{{ e.booking_ids }}"><span class="swatch" style="background: {{ e.colour }}"></span><span class="item-label">{{ e.label }}</span><span class="item-value">{{ e.text }}</span></li>
      {%- endfor %}
      </ul>
    </div>
  </div>
  {%- else %}
  {#- A calendar keeps its cell size and scrolls inside itself when the widget is narrower. #}
  <div class="chart-area{% if n.type == 'calendar' %} calendar-area{% endif %}" id="{{ n.id }}">{% if n.svg is not none %}{{ n.svg | safe }}{% endif %}</div>
  {%- endif %}
  {%- if n.forecast_legend is not none %}
  <p class="forecast-legend"><span><i class="key solid" aria-hidden="true"></i>Actual</span><span><i class="key dashed" aria-hidden="true"></i>Forecast</span>{% if n.forecast_legend.range %}<span><i class="key band" aria-hidden="true"></i>Range</span>{% endif %}</p>
  {%- endif %}</section>
{%- elif n.type == "stack" -%}
<div class="stack" data-component="stack">
  {%- for child in n.children %}{{ node(child) }}{% endfor %}
</div>
{%- elif n.type == "grid" -%}
<div class="grid cols-{{ n.columns }}" data-component="grid">
  {%- for child in n.children %}{{ node(child) }}{% endfor %}
</div>
{%- endif -%}
{%- endmacro %}
